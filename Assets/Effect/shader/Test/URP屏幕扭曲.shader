				float2 panner1171 = ( 1.0 * _Time.y * _Vector0 + rotator1167);
				float3 unpack1175 = UnpackNormalScale( tex2D( _TextureSample0, panner1171 ), ( _Float3 * IN.ase_color.a ) );
				unpack1175.z = lerp( 1, unpack1175.z, saturate(( _Float3 * IN.ase_color.a )) );
				float4 fetchOpaqueVal1180 = float4( SHADERGRAPH_SAMPLE_SCENE_COLOR( ( ase_grabScreenPosNorm + unpack1175.r ).xy ), 1.0 );
				
				float2 texCoord1163 = IN.ase_texcoord4.xy * float2( 1,1 ) + float2( 0,0 );
				float cos1168 = cos( radians( _Float1 ) );
				float sin1168 = sin( radians( _Float1 ) );
				float2 rotator1168 = mul( texCoord1163 - float2( 0.5,0.5 ) , float2x2( cos1168 , -sin1168 , sin1168 , cos1168 )) + float2( 0.5,0.5 );
				float2 panner1170 = ( 1.0 * _Time.y * _Vector1 + rotator1168);
				
				float3 BakedAlbedo = 0;
				float3 BakedEmission = 0;
				float3 Color = fetchOpaqueVal1180.rgb;
				float Alpha = tex2D( _TextureSample1, panner1170 ).r;
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;

				#ifdef _ALPHATEST_ON
					clip( Alpha - AlphaClipThreshold );
				#endif

				#if defined(_DBUFFER)
					ApplyDecalToBaseColor(IN.clipPos, Color);
				#endif

				#if defined(_ALPHAPREMULTIPLY_ON)
